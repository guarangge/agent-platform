{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.zc.com/schema/agent-runtime-plugin.schema.json",
  "title": "Agent Runtime Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pluginCode",
    "version",
    "platformApiVersion",
    "entrypoint",
    "capabilities",
    "dependencies",
    "components"
  ],
  "properties": {
    "pluginCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "platformApiVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)+$"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "filesystem.read",
          "filesystem.write",
          "network.read",
          "network.write",
          "process.execute",
          "database.read",
          "database.write",
          "artifact.publish",
          "external.side_effect"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pluginCode", "versionConstraint", "optional"],
        "properties": {
          "pluginCode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
          },
          "versionConstraint": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {"$ref": "#/$defs/componentCodes"},
        "toolProviders": {"$ref": "#/$defs/componentCodes"},
        "stepHandlers": {"$ref": "#/$defs/componentCodes"},
        "contextProviders": {"$ref": "#/$defs/componentCodes"},
        "policies": {"$ref": "#/$defs/componentCodes"},
        "hooks": {"$ref": "#/$defs/componentCodes"},
        "skills": {"$ref": "#/$defs/componentCodes"}
      }
    }
  },
  "$defs": {
    "componentCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
      }
    }
  }
}
